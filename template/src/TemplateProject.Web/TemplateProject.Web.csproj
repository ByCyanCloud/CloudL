<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>TemplateProject.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Livia.Core" />
    <PackageReference Include="Livia.EntityFrameworkCore" />
    <PackageReference Include="Livia.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TemplateProject.Application\TemplateProject.Application.csproj" />
    <ProjectReference Include="..\TemplateProject.Infrastructure\TemplateProject.Infrastructure.csproj" />
    <ProjectReference Include="..\TemplateProject.EntityFrameworkCore\TemplateProject.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\TemplateProject.HttpApi\TemplateProject.HttpApi.csproj" />
  </ItemGroup>

  <!-- 把被引用项目的 XML 文档复制到输出目录，供 Swagger 展示注释 -->
  <Target Name="CopyReferencedProjectXmlDocumentation" AfterTargets="Build">
    <ItemGroup>
      <_ReferenceProjectXmlDocs
        Include="@(ReferencePath->'%(RootDir)%(Directory)%(Filename).xml')"
        Condition="Exists('%(RootDir)%(Directory)%(Filename).xml')" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_ReferenceProjectXmlDocs)"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
