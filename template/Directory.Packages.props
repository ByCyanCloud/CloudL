<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      本模板默认把框架包版本设为浮动版本（见下方 CloudLVersion），
      以便本地开发时总是解析到最新构建；CPM 下使用浮动版本必须显式开启此开关。
      正式项目建议把 CloudLVersion 固定为具体版本，以保证构建可复现。
    -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>

    <!--
      CloudL 框架包版本：所有包锁步同版本。
      升级框架只需改这一处（或执行 dotnet package update），无需改动任何业务代码。
      用模板生成时可通过 frameworkVersion 参数指定版本，具体命令见本模板 README 的「框架升级」章节。
      注意：XML 注释中不能出现连续两个减号，因此此处不写完整命令行示例。
    -->
    <CloudLVersion Condition="'$(CloudLVersion)' == ''">CLOUDL_VERSION</CloudLVersion>
  </PropertyGroup>

  <ItemGroup Label="CloudL 框架">
    <PackageVersion Include="CloudL.Core" Version="$(CloudLVersion)" />
    <PackageVersion Include="CloudL.EntityFrameworkCore" Version="$(CloudLVersion)" />
    <PackageVersion Include="CloudL.AspNetCore" Version="$(CloudLVersion)" />

    <!-- 数据库提供程序：项目实际引用哪一个，见 TemplateProject.EntityFrameworkCore.csproj -->
    <PackageVersion Include="CloudL.EntityFrameworkCore.PostgreSql" Version="$(CloudLVersion)" />
    <PackageVersion Include="CloudL.EntityFrameworkCore.SqlServer" Version="$(CloudLVersion)" />
  </ItemGroup>

  <ItemGroup Label="应用与持久化">
    <PackageVersion Include="Mapster" Version="7.4.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup Label="宿主、日志与文档">
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="测试">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Moq" Version="4.20.72" />
  </ItemGroup>

</Project>
