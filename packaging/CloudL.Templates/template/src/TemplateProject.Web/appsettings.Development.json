{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=template_db;Username=postgres;Password=postgres"
  },
  "Cors": {
    "AllowAnyOrigin": false,
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Jwt": {
    "SecretKey": "CHANGE ME 请替换为你自己的开发密钥（至少需要 32 位字符长度）"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
