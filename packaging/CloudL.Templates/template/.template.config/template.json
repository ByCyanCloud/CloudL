{
  "$schema": "http://json.schemastore.org/template",
  "author": "CloudL",
  "classifications": [ "Web", "WebAPI", "DDD", "Clean Architecture" ],
  "identity": "CloudL.WebApi",
  "name": "CloudL DDD Web API Framework (.NET 10)",
  "description": "基于 CloudL 框架（NuGet 包）的 DDD 九层 Web API 业务骨架。框架能力全部来自 CloudL.Core / CloudL.EntityFrameworkCore / CloudL.AspNetCore 三个包。",
  "shortName": "cloudl",
  "sourceName": "TemplateProject",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "frameworkVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "0.2.*",
      "replaces": "CLOUDL_VERSION",
      "description": "CloudL 框架包版本。本地开发用浮动版本（0.2.*）即可；正式项目建议锁定为具体版本，例如 1.2.0。"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [ "**/bin/**", "**/obj/**", "**/.vs/**", "**/.git/**" ]
        }
      ]
    }
  ]
}
