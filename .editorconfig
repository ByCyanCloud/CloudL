# 代码风格约定（仓库级唯一权威）
#
# 为什么需要它：没有 .editorconfig 时，代码风格完全取决于每台机器上 IDE 的设置，
# 同一个文件在不同人机器上会报不同的告警（例如 IDE0040 在某些机器上被设成"always + 错误"）。
# .editorconfig 的优先级高于 IDE 的选项对话框，因此它是团队内唯一可信的来源。
#
# 原则：只声明**本仓库确实遵守**的规则，并把纯风格规则的严重级别压到 suggestion ——
#      否则（配合 Directory.Build.props 的 TreatWarningsAsErrors）会把风格提示变成一堵墙。
#
# 本仓库刻意不开启 EnforceCodeStyleInBuild：代码风格不进构建门禁，
# 否则 SDK 升级带来的规则变化（新增或改判的 IDE 规则）可能让构建突然失败。
# 只要 IDE 与这份文件一致，就不会再出现同一份代码在不同机器上报不同告警的问题。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# 接口成员不写 public（C# 默认，也是本仓库现状）—— 这条同时让 IDE0040 不再对接口成员报错
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# 不用 this. / 类型名限定成员
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# using 排序：System 在前，不额外分组
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# 统一使用文件级命名空间
csharp_style_namespace_declarations = file_scoped:warning

# 纯风格规则一律降级，避免变成构建失败
dotnet_diagnostic.IDE0055.severity = suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_prefer_primary_constructors = false:suggestion
