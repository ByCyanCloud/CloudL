<Project>

  <PropertyGroup>
    <!-- 目标框架与语言 -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 文档与静态检查 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- 中央包管理：版本统一在 Directory.Packages.props -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- 版本号：由 git tag（v1.2.3）经 MinVer 计算 -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>

    <!-- 包元数据（发布后不可修改，改动需发新版本号） -->
    <Authors>ByCyanCloud</Authors>
    <Company>ByCyanCloud</Company>
    <Product>CloudL</Product>
    <Copyright>Copyright (c) 2026 ByCyanCloud</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ByCyanCloud/CloudL</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ByCyanCloud/CloudL</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>

    <!-- 依赖漏洞审计：包含传递依赖，低危也报（NU1901-NU1904） -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <!--
      框架代码零警告：警告即错误（NuGet 审计类警告除外，避免审计源不可用时阻断构建）。
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>

    <!--
      Release 构建启用 CI 语义：SDK 会自动做路径映射，
      避免符号包（.snupkg）里的 PDB 泄露本机绝对路径与用户名。
    -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>

    <!-- 默认不打包：仅 src/ 下的框架项目显式打开 IsPackable -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <!-- 把仓库 README 打进包，供 nuget.org 渲染包页面（不打包的项目会忽略该项） -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)README.md')">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
