<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <!-- 公共源：NuGet 官方 -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- 框架包本地源：由 build/pack.ps1 输出到这里，供本机业务项目联调 -->
    <add key="cloudl-local" value="local-feed" />
  </packageSources>

  <!--
    包源映射（Package Source Mapping）：
      1. CloudL.* 允许来自本机联调源与 nuget.org —— 后者的必要性：打包时的 API 兼容性校验
         （ApiCompat）要从 nuget.org 下载上一个已发布版本作为基线，而基线包名也是 CloudL.*；
         我们本身就是 CloudL.* 在 nuget.org 上的发布者，放开这一条不引入依赖混淆风险；
      2. 避免多源混用时的间歇性 403（NuGet 会向所有已配置源查询同一个包）。
      3. 其它包只允许来自 nuget.org。
    将来发布到 GitHub Packages / 私有源时，把该源加进 packageSources 并在此补一条映射。
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="CloudL.*" />
    </packageSource>
    <packageSource key="cloudl-local">
      <package pattern="CloudL.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>