<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <!-- 公共源：NuGet 官方 -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- 框架包本地源：由 build/pack.ps1 输出到这里，供本机业务项目联调 -->
    <add key="livia-local" value="local-feed" />
  </packageSources>

  <!--
    包源映射（Package Source Mapping）：
      1. 防御依赖混淆 —— Livia.* 只允许来自自家源，不可能被 nuget.org 上的同名包顶替；
      2. 避免多源混用时的间歇性 403（NuGet 会向所有已配置源查询同一个包）。
    将来发布到 GitHub Packages / 私有源时，把该源加进 packageSources 并在此补一条映射。
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="livia-local">
      <package pattern="Livia.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>