<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <AssemblyName>CloudL.EntityFrameworkCore.PostgreSql</AssemblyName>
    <RootNamespace>CloudL</RootNamespace>
    <PackageId>CloudL.EntityFrameworkCore.PostgreSql</PackageId>
    <Title>CloudL EntityFrameworkCore PostgreSQL</Title>
    <Description>CloudL DDD 框架的 PostgreSQL 数据库提供程序：为 DbContextOptionsBuilder 提供 UseCloudLPostgreSql。</Description>
    <PackageTags>ddd;entity-framework-core;postgresql;npgsql;framework;cloudl</PackageTags>

    <!--
      本包在 0.1.0 时还不存在，因此没有可比的已发布基线。
      0.2.0 发布之后请删除下面这一行，让它继承 Directory.Build.props 里的基线版本，
      这样它的公开 API 也会受兼容性守卫约束。
    -->
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
