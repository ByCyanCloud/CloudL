<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <AssemblyName>CloudL.Core</AssemblyName>
    <RootNamespace>CloudL</RootNamespace>
    <PackageId>CloudL.Core</PackageId>
    <Title>CloudL Core</Title>
    <Description>CloudL DDD 框架核心：领域基类、共享内核、应用契约、领域事件分发与 Mapster 全局约定。</Description>
    <PackageTags>ddd;clean-architecture;framework;cloudl</PackageTags>
