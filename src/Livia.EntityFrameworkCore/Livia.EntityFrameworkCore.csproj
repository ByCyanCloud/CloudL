<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <AssemblyName>Livia.EntityFrameworkCore</AssemblyName>
    <RootNamespace>Livia</RootNamespace>
    <PackageId>Livia.EntityFrameworkCore</PackageId>
    <Title>Livia EntityFrameworkCore</Title>
    <Description>Livia DDD 框架 EF Core 持久化层：FrameworkDbContext、仓储实现、实体配置基类与泛型注册扩展。</Description>
    <PackageTags>ddd;entity-framework-core;framework;livia</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Livia.Core\Livia.Core.csproj" />
  </ItemGroup>

</Project>